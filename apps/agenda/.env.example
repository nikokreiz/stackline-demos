# Sin variables la demo funciona sola: usa una base embebida (PGlite en .data/)
# y simula los pagos y los mensajes de WhatsApp.

# Postgres real (Supabase, Neon…). Obligatorio al desplegar en Vercel.
# DATABASE_URL=postgres://usuario:clave@host:5432/postgres

# URL pública de la app, para los enlaces de pago y de gestión de la cita.
# APP_URL=https://agenda-demo.vercel.app

# Pagos de abono con Mercado Pago (Checkout Pro). Si falta, el pago se simula.
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# WhatsApp Cloud API. Si falta, los recordatorios se registran como simulados.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=recordatorio_cita
# WHATSAPP_TEMPLATE_LANG=es

# Protege /api/cron/* (Vercel Cron envía "Authorization: Bearer <CRON_SECRET>").
# CRON_SECRET=

# true = el cron diario reinicia los datos de demostración.
# DEMO_MODE=true

# Correos (separados por coma) con acceso al panel /admin de Stackline.
# En desarrollo, sin esta variable, el dueño de la demo (dueno@demo.cl) es administrador.
# SUPERADMIN_EMAILS=tu@correo.cl
